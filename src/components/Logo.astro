---
interface Props {
  size?: number;
}
const { size = 34 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <defs>
    <linearGradient id="lg-logo" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ff2e88"></stop>
      <stop offset="0.55" stop-color="#ff7a3d"></stop>
      <stop offset="1" stop-color="#ffb000"></stop>
    </linearGradient>
  </defs>
  <rect x="3" y="3" width="58" height="58" rx="14" fill="#12121f" stroke="url(#lg-logo)" stroke-width="3"></rect>
  <path
    d="M32 12l5.6 11.6 12.8 1.8-9.3 9 2.3 12.7L32 41.1l-11.4 6 2.3-12.7-9.3-9 12.8-1.8z"
    fill="url(#lg-logo)"></path>
  <rect x="17" y="51" width="30" height="4" rx="2" fill="#29e0ff"></rect>
</svg>

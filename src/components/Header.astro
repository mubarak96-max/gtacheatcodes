---
import Logo from './Logo.astro';

const main = [
  { href: '/gta-5-cheats/', label: 'GTA 5' },
  { href: '/gta-san-andreas-cheats/', label: 'San Andreas' },
  { href: '/gta-vice-city-cheats/', label: 'Vice City' },
  { href: '/gta-4-cheats/', label: 'GTA 4' },
];
const more = [
  { href: '/gta-3-cheats/', label: 'GTA 3' },
  { href: '/gta-trilogy-definitive-edition-cheats/', label: 'Definitive Edition' },
  { href: '/gta-liberty-city-stories-cheats/', label: 'Liberty City Stories' },
  { href: '/gta-vice-city-stories-cheats/', label: 'Vice City Stories' },
  { href: '/gta-chinatown-wars-cheats/', label: 'Chinatown Wars' },
  { href: '/gta-6-cheats/', label: 'GTA 6' },
];
const tools = [
  { href: '/tools/cheat-finder/', label: 'Cheat Finder' },
  { href: '/tools/cheat-trainer/', label: 'Combo Trainer' },
  { href: '/tools/cheat-roulette/', label: 'Cheat Roulette' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="GTA Cheat Codes home">
      <Logo />
      <span class="brand-text display">GTA<span class="grad-text">Cheats</span></span>
    </a>

    <nav class="nav" aria-label="Main">
      {main.map((l) => <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>)}
      <div class="dd">
        <button class="dd-btn" type="button" aria-haspopup="true">More games ▾</button>
        <div class="dd-menu">{more.map((l) => <a href={l.href}>{l.label}</a>)}</div>
      </div>
      <div class="dd">
        <button class="dd-btn" type="button" aria-haspopup="true">Tools ▾</button>
        <div class="dd-menu">{tools.map((l) => <a href={l.href}>{l.label}</a>)}</div>
      </div>
      <a href="/guides/" aria-current={path.startsWith('/guides/') ? 'page' : undefined}>Guides</a>
    </nav>

    <div class="wanted" id="wanted" title="Your wanted level goes up with every page you read" aria-hidden="true">
      {[0, 1, 2, 3, 4].map(() => <span class="star">★</span>)}
    </div>

    <a href="/tools/cheat-finder/" class="search-btn" aria-label="Search all cheats">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      <span>Search cheats</span>
    </a>

    <details class="mobile">
      <summary aria-label="Open menu"><span></span><span></span><span></span></summary>
      <div class="mobile-panel">
        <p class="mh">Games</p>
        {[...main, ...more].map((l) => <a href={l.href}>{l.label}</a>)}
        <p class="mh">Tools</p>
        {tools.map((l) => <a href={l.href}>{l.label}</a>)}
        <p class="mh">Read</p>
        <a href="/guides/">All guides</a>
      </div>
    </details>
  </div>
</header>

<script>
  // Wanted level = pages viewed this session (max five stars).
  try {
    const n = Math.min(5, Number(sessionStorage.getItem('gtacc:wanted') || '0') + 1);
    sessionStorage.setItem('gtacc:wanted', String(n));
    document.querySelectorAll('#wanted .star').forEach((s, i) => {
      if (i < n) s.classList.add('on');
    });
  } catch {}
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(7, 7, 13, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 18px;
    height: 66px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text);
    flex-shrink: 0;
  }
  .brand-text {
    font-size: 26px;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: 12px;
  }
  .nav > a,
  .dd-btn {
    color: var(--muted);
    text-decoration: none;
    font: 600 14.5px/1 var(--font-body);
    padding: 10px 12px;
    border-radius: 8px;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .nav > a:hover,
  .dd-btn:hover,
  .nav > a[aria-current='page'] {
    color: #fff;
    background: var(--panel-2);
  }
  .dd {
    position: relative;
  }
  .dd-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    padding: 8px;
    background: var(--panel);
    border: 1px solid var(--line-2);
    border-radius: 12px;
    box-shadow: var(--shadow);
    display: none;
  }
  .dd:hover .dd-menu,
  .dd:focus-within .dd-menu {
    display: block;
  }
  .dd-menu a {
    display: block;
    padding: 9px 12px;
    border-radius: 8px;
    color: var(--text);
    text-decoration: none;
    font-size: 14.5px;
  }
  .dd-menu a:hover {
    background: var(--panel-2);
  }
  .wanted {
    margin-left: auto;
    display: flex;
    gap: 2px;
    font-size: 17px;
    color: #3a3a52;
    user-select: none;
  }
  .wanted :global(.star.on) {
    color: #fff;
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.55);
    animation: flash 1.2s ease-in-out 2;
  }
  @keyframes flash {
    50% {
      color: #3a3a52;
      text-shadow: none;
    }
  }
  .search-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    color: var(--text);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }
  .search-btn:hover {
    border-color: var(--muted);
    color: #fff;
  }
  .mobile {
    display: none;
  }
  @media (max-width: 1020px) {
    .nav,
    .search-btn span {
      display: none;
    }
    .mobile {
      display: block;
    }
    .search-btn {
      padding: 9px;
    }
    .mobile summary {
      list-style: none;
      width: 42px;
      height: 42px;
      display: grid;
      place-content: center;
      gap: 5px;
      cursor: pointer;
      border: 1px solid var(--line-2);
      border-radius: 10px;
    }
    .mobile summary::-webkit-details-marker {
      display: none;
    }
    .mobile summary span {
      display: block;
      width: 18px;
      height: 2px;
      background: var(--text);
    }
    .mobile-panel {
      position: absolute;
      left: 0;
      right: 0;
      top: 66px;
      max-height: calc(100vh - 66px);
      overflow-y: auto;
      background: var(--bg-2);
      border-bottom: 1px solid var(--line);
      padding: 12px 16px 24px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2px 12px;
    }
    .mobile-panel a {
      padding: 10px 0;
      color: var(--text);
      text-decoration: none;
      border-bottom: 1px solid var(--line);
    }
    .mh {
      grid-column: 1 / -1;
      margin: 14px 0 4px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--sun);
    }
  }
  @media (max-width: 420px) {
    .wanted {
      font-size: 13px;
    }
    .brand-text {
      font-size: 22px;
    }
  }
</style>
